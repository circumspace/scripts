#!/usr/bin/env python3
"""Generate CDE-style 6K wallpapers for solaris-inspired Omarchy themes.

Given one or more Omarchy theme git repo URLs, clones (or updates) each repo
one level above this script's directory, reads its palette.txt, derives the
authentic Motif/Xm colorset from the theme's base color, and renders a set of
classic CDE backdrop tile patterns as crisp 6K PNGs into
    ../<repo-name>/backgrounds/<Pattern>-<light|dark>-6k.png

Patterns are rendered Retina-style: each XPM tile pixel covers --scale
(default 2) output pixels in both axes, so the 6K asset is a @2x render of a
~3K logical design and survives downscaling to 1440p/4K displays without
smearing.

Color derivation is a faithful port of the Motif color math used by CDE and
NsCDE's palette_colorgen (bg / fg / topShadow / bottomShadow / select).

Requires: python3 (stdlib only) and ImageMagick 7 (`magick`).
"""

import argparse
import concurrent.futures
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
WORKSPACE = SCRIPT_DIR.parent  # repos are cloned here (../)

# Curated set of classic CDE/NsCDE backdrop tiles: subtle seamless textures
# that read well as desktop wallpaper. Override with --patterns.
DEFAULT_PATTERNS = [
    "Solyaris", "Dimple", "Dune", "Swirl", "Squares",
    "Marble", "Toronto", "SandLight", "CircuitBoards",
    "Lattice", "Concave", "Convex", "PinStripe", "Bark",
]

TILE_URL = ("https://raw.githubusercontent.com/NsCDE/NsCDE/master/"
            "data/backdrops/{}.pm")

# Motif/Xm color math constants (Xm.h), as used by CDE and NsCDE.
XM_MAX_SHORT = 65535
XM_RED_LUM, XM_GREEN_LUM, XM_BLUE_LUM = 0.30, 0.59, 0.11
XM_INTENSITY_FACTOR, XM_LUMINOSITY_FACTOR = 75, 25
XM_DARK_THRESHOLD, XM_LITE_THRESHOLD, XM_FG_THRESHOLD = 20, 93, 70
XM_LO_SEL, XM_HI_SEL = 15, 15
XM_LO_BS, XM_HI_BS = 60, 40
XM_LO_TS, XM_HI_TS = 50, 60
XM_DARK_SEL, XM_DARK_BS, XM_DARK_TS = 15, 30, 50
XM_LITE_SEL, XM_LITE_BS, XM_LITE_TS = 15, 40, 20

# XPM symbolic name -> colorset slot.
SYMBOL_MAP = {
    "background": "bg",
    "foreground": "fg",
    "topShadowColor": "ts",
    "bottomShadowColor": "bs",
    "selectColor": "sel",
}

# Minimal XPM named-color support (backdrop files use hex almost everywhere).
NAMED_COLORS = {
    "black": "000000", "white": "ffffff",
    "red": "ff0000", "green": "00ff00", "blue": "0000ff",
    "yellow": "ffff00", "magenta": "ff00ff", "cyan": "00ffff",
    "gray": "808080", "grey": "808080",
}


def log(msg):
    print(msg, flush=True)


def die(msg):
    print(f"error: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


# --------------------------------------------------------------- Motif math

def expand16(hex6):
    """'#afb2c3' -> (45039, 45746, 50051): each byte duplicated to 16 bit."""
    r, g, b = (int(hex6[i:i + 2], 16) for i in (1, 3, 5))
    return (r * 0x101, g * 0x101, b * 0x101)


def to_hex6(rgb):
    return "#{:02x}{:02x}{:02x}".format(*(c >> 8 for c in rgb))


def brightness(rgb):
    intensity = sum(rgb) / 3.0
    luminosity = (XM_RED_LUM * rgb[0] + XM_GREEN_LUM * rgb[1]
                  + XM_BLUE_LUM * rgb[2])
    return (intensity * XM_INTENSITY_FACTOR
            + luminosity * XM_LUMINOSITY_FACTOR) / 100.0


def motif_colorset(base_hex):
    """Port of NsCDE palette_colorgen's CalculateColorsFor{Dark,Medium,Light}.

    Returns {"bg","fg","ts","bs","sel"} as '#rrggbb' strings.
    """
    bg = list(expand16(base_hex))
    b = brightness(bg)

    if b < XM_DARK_THRESHOLD / 100 * XM_MAX_SHORT:
        fg = [0, 0, 0] if b > XM_FG_THRESHOLD / 100 * XM_MAX_SHORT \
            else [XM_MAX_SHORT] * 3

        def toward(c, f):
            return [int(v + f * (XM_MAX_SHORT - v) / 100.0) for v in c]
        sel = toward(bg, XM_DARK_SEL)
        bs = toward(bg, XM_DARK_BS)
        ts = toward(bg, XM_DARK_TS)
    elif b > XM_LITE_THRESHOLD / 100 * XM_MAX_SHORT:
        fg = [0, 0, 0] if b > XM_FG_THRESHOLD / 100 * XM_MAX_SHORT \
            else [XM_MAX_SHORT] * 3

        def away(c, f):
            return [int(v - (v * f) / 100.0) for v in c]
        sel = away(bg, XM_LITE_SEL)
        bs = away(bg, XM_LITE_BS)
        ts = away(bg, XM_LITE_TS)
    else:
        fg = [0, 0, 0] if b > XM_FG_THRESHOLD / 100 * XM_MAX_SHORT \
            else [XM_MAX_SHORT] * 3

        def mix(c, f):
            return [int(v - (v * f) / 100.0) for v in c]

        def lift(c, f):
            return [int(v + f * (XM_MAX_SHORT - v) / 100.0) for v in c]
        sel = mix(bg, XM_LO_SEL + b * (XM_HI_SEL - XM_LO_SEL) / XM_MAX_SHORT)
        bs = mix(bg, XM_LO_BS + b * (XM_HI_BS - XM_LO_BS) / XM_MAX_SHORT)
        ts = lift(bg, XM_LO_TS + b * (XM_HI_TS - XM_LO_TS) / XM_MAX_SHORT)

    return {k: to_hex6(v) for k, v in
            {"bg": bg, "fg": fg, "ts": ts, "bs": bs, "sel": sel}.items()}


# ----------------------------------------------------------------- palettes

ROLE_RE = re.compile(r"^\s*([A-Za-z][A-Za-z0-9_]*)\b")
HEX_RE = re.compile(r"#([0-9a-fA-F]{6})\b")


def parse_palette(path):
    """Parse `role  #rrggbb  # comment` / `color00 black #rrggbb` lines."""
    roles = {}
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        m = ROLE_RE.match(s)
        hexes = HEX_RE.findall(s)
        if not m or not hexes:
            continue
        roles.setdefault(m.group(1), "#" + hexes[0].lower())
    return roles


def pick_base(roles, requested):
    order = [requested] if requested else \
        ["chrome", "surface", "canvas", "bg", "background"]
    for role in order:
        if role and role in roles:
            return roles[role], role
    if roles:
        first = next(iter(roles.values()))
        return first, "first-role"
    die("no hex colors found in palette")


# ------------------------------------------------------------------ XPM I/O

QUOTED_RE = re.compile(r'"([^"]*)"')
HEADER_RE = re.compile(r"^\s*(-?\d+)\s+(-?\d+)\s+(\d+)\s+(\d+)")


def parse_xpm(path):
    """Return (width, height, cpp, colors, rows) from the first XPM array.

    colors: {charstring: (symbolic|None, mono|None, hex6|None)}
    Handles leading copyright banners, hotspots, tab separators, space chars.
    """
    strings = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        for m in QUOTED_RE.finditer(line):
            strings.append(m.group(1))
    idx = 0
    header = None
    while idx < len(strings):
        m = HEADER_RE.match(strings[idx])
        if m:
            header = m
            break
        idx += 1
    if not header:
        die(f"{path.name}: no XPM header found")
    w, h, ncolors, cpp = (int(header.group(i)) for i in (1, 2, 3, 4))
    idx += 1

    colors = {}
    for _ in range(ncolors):
        if idx >= len(strings):
            die(f"{path.name}: truncated color section")
        entry = strings[idx]
        idx += 1
        chars, spec = entry[:cpp], entry[cpp:]
        tokens = spec.split()
        symbol = mono = color = None
        i = 0
        while i < len(tokens):
            t = tokens[i]
            if t == "s" and i + 1 < len(tokens):
                symbol = tokens[i + 1]
                i += 2
            elif t == "m" and i + 1 < len(tokens):
                mono = tokens[i + 1].lower()
                i += 2
            elif t == "c":
                rest = tokens[i + 1:]
                if rest:
                    val = rest[0].lower()
                    color = None if val == "none" else val
                    if color and color.startswith("#"):
                        # '#rrrrggggbbbb' (48-bit) or '#rrggbb' (24-bit)
                        digits = color[1:]
                        if len(digits) >= 12:
                            color = digits[0:2] + digits[4:6] + digits[8:10]
                        else:
                            color = digits[0:6]
                i = len(tokens)
            else:
                i += 1
        colors[chars] = (symbol, mono, color)

    rows = []
    for _ in range(h):
        if idx >= len(strings):
            die(f"{path.name}: truncated pixel rows")
        row = strings[idx]
        idx += 1
        if len(row) < w * cpp:
            die(f"{path.name}: pixel row too short")
        rows.append(row[:w * cpp])
    return w, h, cpp, colors, rows


def semantic_of(entry, fg_luma_threshold=0.5):
    """Map an XPM color entry to a colorset slot ('bg','fg','ts','bs','sel')."""
    symbol, mono, color = entry
    if symbol in SYMBOL_MAP:
        return SYMBOL_MAP[symbol]
    if color is None:  # 'None' (transparent) shows the backdrop color
        return "bg"
    hex6 = color
    if hex6 in NAMED_COLORS:
        hex6 = NAMED_COLORS[hex6]
    if hex6 and re.fullmatch(r"[0-9a-f]{6}", hex6):
        r, g, b = (int(hex6[i:i + 2], 16) for i in (0, 2, 4))
        luma = (0.30 * r + 0.59 * g + 0.11 * b) / 255.0
        return "fg" if luma < fg_luma_threshold else "bg"
    if mono in NAMED_COLORS:
        m = NAMED_COLORS[mono]
        luma = int(m[0:2], 16) / 255.0
        return "fg" if luma < 0.5 else "bg"
    return "fg"


def build_tile_ppm(xpm_path, colorset, scale, out_path):
    """Render the XPM tile at scale px/pixel into a binary PPM."""
    w, h, cpp, colors, rows = parse_xpm(xpm_path)

    # Map each char string to a semantic slot, then to rgb bytes.
    table = {}
    for chars, entry in colors.items():
        slot = semantic_of(entry)
        hex6 = colorset[slot].lstrip("#")
        table[chars] = bytes(int(hex6[i:i + 2], 16) for i in (0, 2, 4))

    ow, oh = w * scale, h * scale
    out = bytearray()
    out += f"P6\n{ow} {oh}\n255\n".encode("ascii")
    default = table.get(" " * cpp) or next(iter(table.values()))
    for row in rows:
        scaled = bytearray()
        for x in range(w):
            px = table.get(row[x * cpp:(x + 1) * cpp], default)
            scaled += px * scale
        scaled = bytes(scaled)
        for _ in range(scale):
            out += scaled
    out_path.write_bytes(out)
    return ow, oh


# ------------------------------------------------------------------ magick

def magick_tiled_png(tile, width, height, out_png):
    subprocess.run(
        ["magick", "-size", f"{width}x{height}", f"tile:{tile}",
         "-alpha", "off", f"PNG24:{out_png}"],
        check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)


# -------------------------------------------------------------------- repos

def repo_name(url):
    name = url.rstrip("/").split("/")[-1]
    return name[:-4] if name.endswith(".git") else name


def ensure_repo(url, dest):
    if (dest / ".git").exists():
        r = subprocess.run(["git", "-C", str(dest), "pull", "--ff-only", "-q"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if r.returncode == 0:
            log(f"  updated existing clone: {dest.name}")
        else:
            log(f"  WARNING: pull failed for {dest.name} "
                f"(using working tree as-is): "
                f"{r.stderr.decode(errors='replace').strip()}")
    else:
        r = subprocess.run(["git", "clone", "-q", url, str(dest)],
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if r.returncode != 0:
            die(f"clone failed: {url}\n  "
                f"{r.stderr.decode(errors='replace').strip()}")
        log(f"  cloned: {dest.name}")


# -------------------------------------------------------------------- tiles

def fetch_tiles(patterns, tiles_dir):
    tiles_dir.mkdir(parents=True, exist_ok=True)
    for name in patterns:
        dest = tiles_dir / f"{name}.pm"
        if dest.exists() and dest.stat().st_size > 0:
            continue
        try:
            with urllib.request.urlopen(TILE_URL.format(name), timeout=30) as r:
                dest.write_bytes(r.read())
        except Exception as e:  # noqa: BLE001 - report and continue
            die(f"cannot fetch tile {name}: {e}")


# ------------------------------------------------------------------ per repo

def render_pattern(job):
    name, tile_path, colorset, scale, width, height, out_png, tmpdir = job
    try:
        tile_ppm = Path(tmpdir) / f"{name}.ppm"
        ow, oh = build_tile_ppm(tile_path, colorset, scale, tile_ppm)
        magick_tiled_png(str(tile_ppm), width, height, str(out_png))
        tile_ppm.unlink(missing_ok=True)
        return name, None
    except Exception as e:  # noqa: BLE001 - report per-pattern failure
        return name, e


def process_repo(url, args):
    dest = WORKSPACE / repo_name(url)
    log(f"{dest.name}:")
    ensure_repo(url, dest)

    palette = dest / "palette.txt"
    if not palette.exists():
        log("  WARNING: no palette.txt, skipping")
        return
    roles = parse_palette(palette)
    base, role = pick_base(roles, args.base)
    colorset = motif_colorset(base)
    suffix = args.suffix or ("dark" if brightness(expand16(base))
                             < XM_MAX_SHORT / 2 else "light")

    b = brightness(expand16(base)) / XM_MAX_SHORT
    log(f"  palette: base {base} (role '{role}', "
        f"brightness {b:.2f}, {'dark' if suffix == 'dark' else 'light'})")
    for slot in ("bg", "fg", "ts", "bs", "sel"):
        log(f"    {slot:3} {colorset[slot]}")

    outdir = dest / args.outdir
    outdir.mkdir(parents=True, exist_ok=True)

    fetch_tiles(args.patterns, args.tiles_dir)

    width, height = args.width, args.height
    jobs = []
    with tempfile.TemporaryDirectory(prefix="cde-wp-") as tmpdir:
        for name in args.patterns:
            tile_path = args.tiles_dir / f"{name}.pm"
            out_png = outdir / f"{name}-{suffix}-{args.tag}.png"
            jobs.append((name, tile_path, colorset, args.scale,
                         width, height, out_png, tmpdir))
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as ex:
            for name, err in ex.map(render_pattern, jobs):
                if err:
                    log(f"  WARNING: {name}: {err}")
                else:
                    log(f"  wrote {name}-{suffix}-{args.tag}.png")
    log(f"  done: {len(jobs)} wallpaper(s) in {outdir}")


# --------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(
        description="Generate CDE-style 6K wallpapers for Omarchy themes "
                    "(Retina-style @2x pattern rendering).",
        epilog="Example: %(prog)s "
               "https://github.com/circumspace/omarchy-solstice-daylight-theme "
               "https://github.com/circumspace/omarchy-solstice-nightwatch-theme")
    ap.add_argument("repos", nargs="+", metavar="REPO_URL")
    ap.add_argument("--scale", type=int, default=2,
                    help="output pixels per XPM tile pixel (default 2 = @2x)")
    ap.add_argument("--width", type=int, default=6144)
    ap.add_argument("--height", type=int, default=3456)
    ap.add_argument("--tag", default="6k",
                    help="resolution tag in output filenames (default 6k)")
    ap.add_argument("--base", metavar="ROLE",
                    help="palette.txt role used as backdrop base color "
                         "(default: chrome|surface|canvas|first)")
    ap.add_argument("--suffix", choices=("light", "dark"),
                    help="force filename suffix instead of deriving it "
                         "from palette brightness")
    ap.add_argument("--outdir", default="backgrounds",
                    help="subdirectory inside each theme repo "
                         "(default backgrounds)")
    ap.add_argument("--patterns", metavar="P1,P2,...",
                    default=",".join(DEFAULT_PATTERNS),
                    help="comma-separated NsCDE backdrop names "
                         f"(default: {','.join(DEFAULT_PATTERNS)})")
    ap.add_argument("--tiles-dir", type=Path,
                    default=SCRIPT_DIR / ".cde-tiles",
                    help="cache dir for downloaded .pm tiles "
                         f"(default {SCRIPT_DIR / '.cde-tiles'})")
    ap.add_argument("--jobs", type=int, default=min(4, os.cpu_count() or 1))
    args = ap.parse_args()

    if shutil.which("magick") is None:
        die("ImageMagick 7 'magick' not found on PATH")
    if args.scale < 1 or args.width < 1 or args.height < 1:
        die("--scale/--width/--height must be positive")
    args.patterns = [p.strip() for p in args.patterns.split(",") if p.strip()]
    if not args.patterns:
        die("no patterns requested")

    for url in args.repos:
        process_repo(url, args)


if __name__ == "__main__":
    main()

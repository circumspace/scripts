#!/usr/bin/env python3
"""Regenerate ~/.omp/agent/models.yml from the live ppq.ai chat-model catalog.

The ppq.ai /v1/models endpoint is public (no API key). omp discovers each
model's context window / capabilities from that same endpoint at runtime;
this script keeps the static id/name list in models.yml current so new
models appear immediately without a manual edit.

Usage:
  omp-ppq-model-refresh                 # refresh models.yml in place (backs up old copy)
  omp-ppq-model-refresh --check         # report drift; write nothing; exit 1 if stale
  omp-ppq-model-refresh --out PATH      # write elsewhere (for testing)
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
import urllib.error
import urllib.request
from datetime import datetime, timezone

API_URL = "https://api.ppq.ai/v1/models"
DEFAULT_OUT = os.path.expanduser("~/.omp/agent/models.yml")

# Provider block constants — must match what omp expects for this endpoint.
PROVIDER_NAME = "ppq.ai"
BASE_URL = "https://api.ppq.ai"
API_KIND = "openai-responses"
API_KEY_ENV = "PPQ_AI_API_KEY"

# Guard against wiping the file during a partial API outage: refuse to
# shrink the list below this fraction of the existing entry count.
MIN_RETAINED_FRACTION = 0.5


def fetch_models(url: str = API_URL) -> list[dict]:
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        payload = json.load(resp)
    data = payload.get("data") or []
    chat = [m for m in data if m.get("type") == "chat" and m.get("id")]
    # Newest first, dedupe by id (API can surface aliases).
    chat.sort(key=lambda m: m.get("created_at") or 0, reverse=True)
    seen: set[str] = set()
    unique = []
    for m in chat:
        if m["id"] not in seen:
            seen.add(m["id"])
            unique.append(m)
    return unique


def yq(s: str) -> str:
    """Double-quote a YAML scalar, escaping backslashes, quotes, controls."""
    out = s.replace("\\", "\\\\").replace('"', '\\"')
    out = "".join(ch if ch >= " " else f"\\{ord(ch):02X}" for ch in out)
    return f'"{out}"'


def render(models: list[dict]) -> str:
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    lines = [
        f"# GENERATED by omp-ppq-model-refresh on {stamp}. Do not hand-edit.",
        f"# Source: {API_URL}  ({len(models)} chat models; context windows",
        "# auto-discovered from the API by omp at runtime).",
        "providers:",
        f"  {PROVIDER_NAME}:",
        f"    baseUrl: {BASE_URL}",
        f"    api: {API_KIND}",
        f"    apiKey: {API_KEY_ENV}",
        "    models:",
    ]
    for m in models:
        name = m.get("name") or m["id"]
        lines.append(f"      - id: {yq(m['id'])}")
        lines.append(f"        name: {yq(name)}")
    return "\n".join(lines) + "\n"


def existing_count(path: str) -> int:
    try:
        with open(path, encoding="utf-8") as f:
            return len(re.findall(r"^\s+- id:", f.read(), re.M))
    except FileNotFoundError:
        return 0


def validate(text: str, expect: int) -> None:
    import yaml  # noqa: F401 — optional deep check

    doc = yaml.safe_load(text)
    models = doc["providers"][PROVIDER_NAME]["models"]
    assert len(models) == expect, f"roundtrip lost entries: {len(models)} != {expect}"
    assert all(isinstance(m["id"], str) and m["id"] for m in models)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--out", default=DEFAULT_OUT)
    ap.add_argument("--url", default=API_URL)
    ap.add_argument("--check", action="store_true", help="report drift only")
    args = ap.parse_args()

    try:
        models = fetch_models(args.url)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError) as e:
        print(f"error: could not fetch catalog: {e}", file=sys.stderr)
        return 2
    if not models:
        print("error: API returned zero chat models; refusing to write", file=sys.stderr)
        return 2

    old = existing_count(args.out)
    if old and len(models) < old * MIN_RETAINED_FRACTION:
        print(
            f"error: fetched {len(models)} models but file lists {old} — "
            f"looks like a partial API outage; refusing to clobber",
            file=sys.stderr,
        )
        return 2

    text = render(models)
    try:
        validate(text, len(models))
    except Exception as e:
        print(f"error: generated YAML failed validation: {e}", file=sys.stderr)
        return 2

    if args.check:
        try:
            with open(args.out, encoding="utf-8") as f:
                current = f.read()
        except FileNotFoundError:
            current = ""
        # Compare only the id lists (header timestamp differs per run).
        ids = re.compile(r'^\s+- id: "?([^"\n]*)"?\s*$', re.M)
        stale = ids.findall(current) != ids.findall(text)
        print("up to date" if not stale else "models.yml is stale — run omp-ppq-model-refresh")
        return 1 if stale else 0

    out_dir = os.path.dirname(args.out) or "."
    os.makedirs(out_dir, exist_ok=True)
    if os.path.exists(args.out):
        with open(args.out, encoding="utf-8") as f:
            if f.read() == text:
                print(f"{args.out}: already current ({len(models)} models)")
                return 0
        try:
            with open(args.out, encoding="utf-8") as src, \
                 open(args.out + ".bak", "w", encoding="utf-8") as dst:
                dst.write(src.read())
        except OSError:
            pass  # best-effort backup; don't block the refresh
    fd, tmp = tempfile.mkstemp(dir=out_dir, suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, args.out)
    except BaseException:
        os.unlink(tmp)
        raise
    print(f"wrote {args.out}: {len(models)} chat models")
    return 0


if __name__ == "__main__":
    sys.exit(main())
